{
  "id": "todo-api",
  "name": "Go Todo API",
  "description": "Template-derived managed Go Todo API backed by PostgreSQL.",
  "version": "0.1.0",
  "enabled": true,
  "depend_on": [
    "postgres"
  ],
  "endpoints": [
    {
      "id": "web",
      "kind": "network",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 18553,
        "strategy": "preferred"
      },
      "exposure": "local",
      "primary": true
    }
  ],
  "env": {
    "TODO_API_PORT": "${endpoint.web.port}",
    "TODO_DATABASE_STATE": "${SERVICE_ROOT}/../postgres/.state/runtime.json"
  },
  "healthchecks": [
    {
      "id": "http-health",
      "type": "http",
      "url": "http://127.0.0.1:${endpoint.web.port}/healthz",
      "expected_status": 200,
      "retries": 80,
      "interval": 250
    }
  ],
  "meta": {
    "license": "Apache-2.0",
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-todo-api.git"
    },
    "documentationUrl": "https://github.com/service-lasso/lasso-todo-api/blob/develop/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-todo-api/issues"
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-todo-api",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-todo-api-win32.zip",
        "archiveType": "zip",
        "command": "./runtime/todo-api.exe",
        "args": []
      },
      "linux": {
        "assetName": "lasso-todo-api-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/todo-api",
        "args": []
      },
      "darwin": {
        "assetName": "lasso-todo-api-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/todo-api",
        "args": []
      }
    }
  }
}
